# Copy this file to .env and fill in the values. Never commit .env.
# The same values go into Vercel -> Settings -> Environment Variables.

# Supabase: Project Settings -> Data API / API Keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_SECRET=
DASHBOARD_KEY=

# Your UTC offset in hours, e.g. 4 for Dubai, 0 for London in winter
TZ_OFFSET_HOURS=

# Read only key for your coach 
COACH_KEY=
